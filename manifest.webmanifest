{
  "name": "CSS Roadmap Tracker",
  "short_name": "CSS Tracker",
  "description": "Track your CSS roadmap to React-ready confidence.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3efe7",
  "theme_color": "#f3efe7",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "categories": [
    "education",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}